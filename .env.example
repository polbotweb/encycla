# Encycla configuration. Copy to .env and fill in. Never commit .env.
# The server refuses to start in production when a required value is missing or weak.

# development | production
NODE_ENV=development
PORT=3000
# Exact public origin, https and no trailing slash in production (e.g. https://encycla.example.com).
PUBLIC_ORIGIN=http://localhost:5173
DATABASE_PATH=data/encycla.db
LOG_LEVEL=info

# Admin routes (/api/admin/*, TikTok room creation). Required in production:
# at least 32 random characters. Generate with: openssl rand -hex 32
# Left empty in development, the admin routes are disabled.
ADMIN_TOKEN=

# Number of reverse proxies in front of the server (Caddy/Nginx): true = 1, or a hop count.
# Leave false when the server is reached directly.
TRUST_PROXY=false

# Optional TikTok Live connector (unofficial, AGPL-3.0, see docs/TIKTOK.md and docs/LICENSES.md).
# Needs the optional package: Docker image built with WITH_TIKTOK=true.
TIKTOK_ENABLED=false
TIKTOK_USERNAME=
# Cookie of a dedicated TikTok account: sessionid=<value>; tt-target-idc=<value>
TIKTOK_SESSION_COOKIE=
# Optional Euler Stream signing key (higher quotas).
TIKTOK_SIGN_API_KEY=

# Build-time only (offline question generation); never needed by the game server.
GEMINI_API_KEY=

# docker compose: domain served by the bundled Caddy proxy (profile "proxy").
DOMAIN=
