{
  "name": "encycla",
  "private": true,
  "license": "MIT",
  "author": "Ishaq74",
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build && node scripts/compress-assets.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=chromium --project=tiktok",
    "test:e2e:mobile": "playwright test --project=mobile-pixel --project=mobile-iphone",
    "docs:screenshots": "node scripts/e2e/docs-screenshots.mjs",
    "test:load": "tsx scripts/load-test.ts",
    "data:extract": "tsx scripts/extract-legacy-questions.ts",
    "data:validate": "tsx scripts/validate-questions.ts",
    "data:wikipedia": "tsx scripts/generate-wikipedia-questions.ts",
    "data:import": "tsx scripts/import-questions.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand": "tsx scripts/brand/build-brand.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.4",
    "zod": "^4.1.12",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/opentype.js": "1.3.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^31.0.1",
    "opentype.js": "1.3.4",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.48.1",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "optionalDependencies": {
    "tiktok-live-connector": "2.5.0"
  }
}
